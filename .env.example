# --- Supabase (preferred: Vite-style names) ---
# Get these from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Aliases also honoured by the Replit run command ---
# (Vite only exposes VITE_* vars to the browser, so prefer the names above.)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Optional ---
# Comma-separated emails that get admin access in demo mode
# VITE_DEMO_ADMINS=
